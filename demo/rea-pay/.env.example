# Rea Pay demo environment template.
# Copy to .env and fill in real values. DEMO FILE: values below are
# deliberately classical so the scanner flags them.
SIGNING_KEY_TYPE=ECDSA_SECP256K1
JWT_ALG=RS256
CERT_PATH=keys/server-rsa.crt
TLS_CIPHERS=ECDHE-RSA-AES128-SHA
KMS_KEY_TYPE=RSA_2048
HSM_MODULE=pkcs11-soft-token
